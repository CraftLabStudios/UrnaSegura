# Copie para .env e ajuste. Em produção (NODE_ENV=production) JWT_SECRET e DATA_KEY são obrigatórios.

# MongoDB local, Docker ou Atlas
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=urna_segura

# Nós do ledger (réplicas). Por padrão todos ficam no mesmo MONGODB_URI, em bancos separados.
# Para separar fisicamente cada nó, defina LEDGER_URI_<nome>:
LEDGER_NODES=no_tse,no_tre_sc,no_tre_sp
# LEDGER_URI_no_tre_sp=mongodb+srv://usuario:senha@outro-cluster.mongodb.net

# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=

SESSION_MINUTES=10
PORT=3001
# Atrás de proxy (Nginx, Vercel, Render): número de proxies confiáveis, ex.: 1
TRUST_PROXY=loopback

# Limites por IP. Numa seção eleitoral real vários eleitores saem pelo mesmo IP: ajuste conforme o cenário.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_VOTO=5

# Usados apenas pelo seed (ambiente de demonstração)
JUNTA_PASSPHRASE=junta-eleitoral-demo-2026
