{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "seed": "tsx --env-file-if-exists=../.env src/scripts/seed.ts",
    "token": "tsx --env-file-if-exists=../.env src/scripts/token.ts",
    "demo:adulterar": "tsx --env-file-if-exists=../.env src/scripts/adulterar.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "testar": "tsx --env-file-if-exists=../.env src/scripts/testar.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}